# HTTP port (optional, defaults to 8000)
PORT=8000

# Postgres connection (required). The app builds the DSN from these parts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_db
# Compose publishes Postgres on 5433 so it does not collide with a local server.
DB_HOST=localhost
DB_PORT=5433

# Redis address (optional, defaults to localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6380

# RabbitMQ connection (optional, defaults to guest/guest localhost:5672)
RABBITMQ_USER=app
RABBITMQ_PASS=app
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Auth gRPC service (optional, defaults to localhost:50051 for the API and
# 0.0.0.0:50051 for the auth service itself)
AUTH_GRPC_HOST=localhost
AUTH_GRPC_PORT=50051

# API key the auth service accepts. Unset means every key is rejected.
AUTH_API_KEY=change-me
