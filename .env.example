# HTTP port (optional, defaults to 8000)
PORT=8000

# Postgres connection (required)
# The app builds DATABASE_URL from these values.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=url_db
DB_HOST=localhost
DB_PORT=5432

# Optional: a full connection string wins over the values above.
# DATABASE_URL=postgres://user:password@localhost:5432/url_db?sslmode=disable

# Redis address as host:port (optional, defaults to localhost:6379)
REDIS_URL=localhost:6379

# RabbitMQ URL (optional, defaults to amqp://guest:guest@localhost:5672/)
# The included Compose file creates this user.
RABBITMQ_URL=amqp://app:app@localhost:5672/
